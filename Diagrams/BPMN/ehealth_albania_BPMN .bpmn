<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="ehealth_albania_process" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_ehealth">
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Participant_Receptionist" name="Receptionist" processRef="Process_Receptionist" />
    <bpmn:participant id="Participant_Doctor" name="Doctor" processRef="Process_Doctor" />
    <bpmn:participant id="Participant_LabTech" name="Lab Technician" processRef="Process_LabTech" />
    <bpmn:participant id="Participant_Pharmacy" name="Pharmacy" processRef="Process_Pharmacy" />
    <bpmn:messageFlow id="MF_PrescToPharmacy" name="Prescription via API" sourceRef="T_CreatePrescription" targetRef="T_UpdatePharmacyRecord" />
    <bpmn:messageFlow id="MF_LabOrderToTech" name="Lab Order" sourceRef="T_OrderLabTest" targetRef="SE_LabRequestReceived" />
    <bpmn:messageFlow id="MF_NotifToPatient" name="SMS / Email Confirmation" sourceRef="T_ConfirmAppointment" targetRef="T_PatientReceivesConfirm" />
    <bpmn:messageFlow id="MF_PortalBooking" name="Self-booking via Portal" sourceRef="T_PatientSelfBook" targetRef="T_ReceivePortalBooking" />
    <bpmn:messageFlow id="MF_LabResultToDoc" name="Lab Results Alert" sourceRef="T_EnterResults" targetRef="T_ReviewLabResults" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" isExecutable="false">
    <bpmn:sequenceFlow id="SF_Pat1" sourceRef="SE_PatientStart" targetRef="GW_PatChannel" />
    <bpmn:sequenceFlow id="SF_PatWalkIn" name="Walk-in" sourceRef="GW_PatChannel" targetRef="T_PatientWalkIn" />
    <bpmn:sequenceFlow id="SF_PatPortal" name="Portal" sourceRef="GW_PatChannel" targetRef="T_PatientSelfBook" />
    <bpmn:sequenceFlow id="SF_PatEnd" sourceRef="T_PatientViewRecord" targetRef="EE_Patient" />
    <bpmn:sequenceFlow id="SF_PatAfterConsult" sourceRef="T_PatientAttendConsult" targetRef="T_PatientViewRecord" />
    <bpmn:sequenceFlow id="SF_PatAttend" sourceRef="T_PatientReceivesConfirm" targetRef="T_PatientAttendConsult" />
    <bpmn:sequenceFlow id="SF_PatWait" sourceRef="GW_PatMerge" targetRef="T_PatientReceivesConfirm" />
    <bpmn:sequenceFlow id="SF_PatMerge1" sourceRef="T_PatientWalkIn" targetRef="GW_PatMerge" />
    <bpmn:sequenceFlow id="SF_PatMerge2" sourceRef="T_PatientSelfBook" targetRef="GW_PatMerge" />
    <bpmn:startEvent id="SE_PatientStart" name="Patient Arrives / Accesses Portal">
      <bpmn:outgoing>SF_Pat1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_PatientWalkIn" name="Walk into Health Centre">
      <bpmn:incoming>SF_PatWalkIn</bpmn:incoming>
      <bpmn:outgoing>SF_PatMerge1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_PatChannel" name="Walk-in or Portal?">
      <bpmn:incoming>SF_Pat1</bpmn:incoming>
      <bpmn:outgoing>SF_PatWalkIn</bpmn:outgoing>
      <bpmn:outgoing>SF_PatPortal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_PatMerge" name="Merge">
      <bpmn:incoming>SF_PatMerge1</bpmn:incoming>
      <bpmn:incoming>SF_PatMerge2</bpmn:incoming>
      <bpmn:outgoing>SF_PatWait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_PatientReceivesConfirm" name="Receive Appointment Confirmation (SMS / Email)">
      <bpmn:incoming>SF_PatWait</bpmn:incoming>
      <bpmn:outgoing>SF_PatAttend</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_PatientAttendConsult" name="Attend Consultation">
      <bpmn:incoming>SF_PatAttend</bpmn:incoming>
      <bpmn:outgoing>SF_PatAfterConsult</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_PatientViewRecord" name="View Medical Record on Patient Portal">
      <bpmn:incoming>SF_PatAfterConsult</bpmn:incoming>
      <bpmn:outgoing>SF_PatEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_Patient" name="Visit Complete">
      <bpmn:incoming>SF_PatEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_PatientSelfBook" name="Self-Book Appointment via Portal">
      <bpmn:incoming>SF_PatPortal</bpmn:incoming>
      <bpmn:outgoing>SF_PatMerge1</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_Receptionist" isExecutable="false">
    <bpmn:task id="T_ScheduleAppointment" name="Schedule Appointment&#10;(Select Doctor + Date + Time Slot)">
      <bpmn:incoming>SF_ScheduleAppt</bpmn:incoming>
      <bpmn:outgoing>SF_ApptToGW</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_MergePatient" name="Patient Record Ready">
      <bpmn:incoming>SF_AfterRegister</bpmn:incoming>
      <bpmn:incoming>SF_AfterSearch</bpmn:incoming>
      <bpmn:outgoing>SF_ScheduleAppt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_ReceivePortalBooking" name="Receive Portal Booking Notification">
      <bpmn:outgoing>SF_RPortalToGW</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SF_R1" sourceRef="SE_PatientWalksIn" targetRef="GW_NewOrExisting" />
    <bpmn:sequenceFlow id="SF_RPortalToGW" sourceRef="T_ReceivePortalBooking" targetRef="GW_NewOrExisting" />
    <bpmn:sequenceFlow id="SF_NewPatient" name="New Patient" sourceRef="GW_NewOrExisting" targetRef="T_RegisterPatient" />
    <bpmn:sequenceFlow id="SF_ExistingPatient" name="Existing Patient" sourceRef="GW_NewOrExisting" targetRef="T_SearchPatient" />
    <bpmn:sequenceFlow id="SF_SlotYes" name="Yes - Available" sourceRef="GW_SlotAvailable" targetRef="T_ConfirmAppointment" />
    <bpmn:sequenceFlow id="SF_ReceptionEnd" sourceRef="T_ConfirmAppointment" targetRef="EE_Reception" />
    <bpmn:sequenceFlow id="SF_ApptToGW" sourceRef="T_ScheduleAppointment" targetRef="GW_SlotAvailable" />
    <bpmn:sequenceFlow id="SF_ScheduleAppt" sourceRef="GW_MergePatient" targetRef="T_ScheduleAppointment" />
    <bpmn:sequenceFlow id="SF_AfterRegister" sourceRef="T_RegisterPatient" targetRef="GW_MergePatient" />
    <bpmn:sequenceFlow id="SF_AfterSearch" sourceRef="T_SearchPatient" targetRef="GW_MergePatient" />
    <bpmn:sequenceFlow id="SF_SlotNo" name="No - Taken" sourceRef="GW_SlotAvailable" targetRef="T_ChooseAnotherSlot" />
    <bpmn:endEvent id="EE_Reception" name="Appointment Confirmed">
      <bpmn:incoming>SF_ReceptionEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_ConfirmAppointment" name="Confirm Appointment&#10;&#38; Send SMS / Email Notification">
      <bpmn:incoming>SF_SlotYes</bpmn:incoming>
      <bpmn:outgoing>SF_ReceptionEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_SlotAvailable" name="Time Slot Available?">
      <bpmn:incoming>SF_ApptToGW</bpmn:incoming>
      <bpmn:outgoing>SF_SlotYes</bpmn:outgoing>
      <bpmn:outgoing>SF_SlotNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="SE_PatientWalksIn" name="Patient Walks In / Portal Booking Received">
      <bpmn:outgoing>SF_R1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_RegisterPatient" name="Register New Patient&#10;(Enter Details, Generate Unique ID)">
      <bpmn:incoming>SF_NewPatient</bpmn:incoming>
      <bpmn:outgoing>SF_AfterRegister</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_NewOrExisting" name="New or Existing Patient?">
      <bpmn:incoming>SF_R1</bpmn:incoming>
      <bpmn:incoming>SF_RPortalToGW</bpmn:incoming>
      <bpmn:outgoing>SF_NewPatient</bpmn:outgoing>
      <bpmn:outgoing>SF_ExistingPatient</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_SearchPatient" name="Search Existing Patient&#10;(by Name or Patient ID)">
      <bpmn:incoming>SF_ExistingPatient</bpmn:incoming>
      <bpmn:outgoing>SF_AfterSearch</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_ChooseAnotherSlot" name="Select Alternative Time Slot">
      <bpmn:incoming>SF_SlotNo</bpmn:incoming>
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_Doctor" isExecutable="false">
    <bpmn:task id="T_IssueReferral" name="Issue Referral with Attached&#10;Medical History">
      <bpmn:incoming>SF_IssueReferral</bpmn:incoming>
      <bpmn:outgoing>SF_ReferralDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_Doctor" name="Consultation Complete">
      <bpmn:incoming>SF_DoctorEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_D1" sourceRef="SE_DoctorConsults" targetRef="T_ReviewHistory" />
    <bpmn:sequenceFlow id="SF_D2" sourceRef="T_ReviewHistory" targetRef="T_RecordDiagnosis" />
    <bpmn:sequenceFlow id="SF_D3" sourceRef="T_RecordDiagnosis" targetRef="GW_ClinicalActions" />
    <bpmn:sequenceFlow id="SF_ToPrescription" sourceRef="GW_ClinicalActions" targetRef="T_CreatePrescription" />
    <bpmn:sequenceFlow id="SF_ToLabOrder" sourceRef="GW_ClinicalActions" targetRef="T_OrderLabTest" />
    <bpmn:sequenceFlow id="SF_ToReferralCheck" sourceRef="GW_ClinicalActions" targetRef="GW_ReferralNeeded" />
    <bpmn:sequenceFlow id="SF_LabOrderDone" name="" sourceRef="T_OrderLabTest" targetRef="GW_MergeActions" />
    <bpmn:sequenceFlow id="SF_IssueReferral" name="Yes" sourceRef="GW_ReferralNeeded" targetRef="T_IssueReferral" />
    <bpmn:sequenceFlow id="SF_NoReferral" name="No" sourceRef="GW_ReferralNeeded" targetRef="GW_MergeActions" />
    <bpmn:sequenceFlow id="SF_ReferralDone" sourceRef="T_IssueReferral" targetRef="GW_MergeActions" />
    <bpmn:sequenceFlow id="SF_ToFollowUp" sourceRef="GW_MergeActions" targetRef="T_ScheduleFollowUp" />
    <bpmn:sequenceFlow id="SF_DoctorEnd" sourceRef="T_ScheduleFollowUp" targetRef="EE_Doctor" />
    <bpmn:sequenceFlow id="SF_PrescDone" sourceRef="T_CreatePrescription" targetRef="GW_MergeActions" />
    <bpmn:task id="T_RecordDiagnosis" name="Record Diagnosis &#38; Clinical Notes&#10;(System Timestamps Record)">
      <bpmn:incoming>SF_D2</bpmn:incoming>
      <bpmn:outgoing>SF_D3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_ReviewHistory" name="Review Patient Medical History,&#10;Allergies &#38; Triage Vitals">
      <bpmn:incoming>SF_D1</bpmn:incoming>
      <bpmn:outgoing>SF_D2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="SE_DoctorConsults" name="Patient Enters Consultation Room">
      <bpmn:outgoing>SF_D1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="GW_ClinicalActions" name="Parallel Clinical Actions">
      <bpmn:incoming>SF_D3</bpmn:incoming>
      <bpmn:outgoing>SF_ToPrescription</bpmn:outgoing>
      <bpmn:outgoing>SF_ToLabOrder</bpmn:outgoing>
      <bpmn:outgoing>SF_ToReferralCheck</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_ReferralNeeded" name="Referral to External Hospital Needed?">
      <bpmn:incoming>SF_ToReferralCheck</bpmn:incoming>
      <bpmn:outgoing>SF_IssueReferral</bpmn:outgoing>
      <bpmn:outgoing>SF_NoReferral</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_ScheduleFollowUp" name="Schedule Follow-Up Appointment&#10;(System Sends SMS Reminder)">
      <bpmn:incoming>SF_ToFollowUp</bpmn:incoming>
      <bpmn:outgoing>SF_DoctorEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_ReviewLabResults" name="Review Lab Results&#10;(Received from Lab Tech)" />
    <bpmn:task id="T_OrderLabTest" name="Order Lab Tests&#10;(System Notifies Lab Tech)">
      <bpmn:incoming>SF_ToLabOrder</bpmn:incoming>
      <bpmn:outgoing>SF_LabOrderDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="GW_MergeActions" name="Merge Clinical Actions">
      <bpmn:incoming>SF_PrescDone</bpmn:incoming>
      <bpmn:incoming>SF_LabOrderDone</bpmn:incoming>
      <bpmn:incoming>SF_ReferralDone</bpmn:incoming>
      <bpmn:incoming>SF_NoReferral</bpmn:incoming>
      <bpmn:outgoing>SF_ToFollowUp</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T_CreatePrescription" name="Create Electronic Prescription&#10;(Drug Interaction Check)">
      <bpmn:incoming>SF_ToPrescription</bpmn:incoming>
      <bpmn:outgoing>SF_PrescDone</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_LabTech" isExecutable="false">
    <bpmn:startEvent id="SE_LabRequestReceived" name="Lab Order Received from Doctor">
      <bpmn:outgoing>SF_L1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_ScanBarcode" name="Scan Patient QSHMS Barcode&#10;&#38; Collect Sample">
      <bpmn:incoming>SF_L1</bpmn:incoming>
      <bpmn:outgoing>SF_L2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_PerformTest" name="Perform Lab Test">
      <bpmn:incoming>SF_L2</bpmn:incoming>
      <bpmn:outgoing>SF_L3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_EnterResults" name="Enter Results into System&#10;(Linked to Patient Record)">
      <bpmn:incoming>SF_L3</bpmn:incoming>
      <bpmn:outgoing>SF_L4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Abnormal" name="Abnormal Result?">
      <bpmn:incoming>SF_L4</bpmn:incoming>
      <bpmn:outgoing>SF_AlertDoctor</bpmn:outgoing>
      <bpmn:outgoing>SF_Normal</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_FlagAbnormal" name="System Flags Abnormal Result&#10;&#38; Sends Alert to Doctor">
      <bpmn:incoming>SF_AlertDoctor</bpmn:incoming>
      <bpmn:outgoing>SF_LabMerge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SF_L1" sourceRef="SE_LabRequestReceived" targetRef="T_ScanBarcode" />
    <bpmn:sequenceFlow id="SF_L2" sourceRef="T_ScanBarcode" targetRef="T_PerformTest" />
    <bpmn:sequenceFlow id="SF_L3" sourceRef="T_PerformTest" targetRef="T_EnterResults" />
    <bpmn:sequenceFlow id="SF_L4" sourceRef="T_EnterResults" targetRef="GW_Abnormal" />
    <bpmn:sequenceFlow id="SF_AlertDoctor" name="Yes - Abnormal" sourceRef="GW_Abnormal" targetRef="T_FlagAbnormal" />
    <bpmn:sequenceFlow id="SF_Normal" name="No - Normal" sourceRef="GW_Abnormal" targetRef="T_MarkCompleted" />
    <bpmn:sequenceFlow id="SF_LabEnd" sourceRef="T_MarkCompleted" targetRef="EE_Lab" />
    <bpmn:sequenceFlow id="SF_LabMerge" sourceRef="T_FlagAbnormal" targetRef="T_MarkCompleted" />
    <bpmn:endEvent id="EE_Lab" name="Lab Request Completed">
      <bpmn:incoming>SF_LabEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_MarkCompleted" name="Mark Request as&#10;&#39;Completed - Reviewed by Clinician&#39;">
      <bpmn:incoming>SF_LabMerge</bpmn:incoming>
      <bpmn:incoming>SF_Normal</bpmn:incoming>
      <bpmn:outgoing>SF_LabEnd</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:process id="Process_Pharmacy" isExecutable="false">
    <bpmn:sequenceFlow id="SF_PEnd" sourceRef="T_UpdatePharmacyRecord" targetRef="EE_Pharmacy" />
    <bpmn:sequenceFlow id="SF_P3" sourceRef="T_DispenseMedication" targetRef="T_UpdatePharmacyRecord" />
    <bpmn:sequenceFlow id="SF_P2" sourceRef="T_VerifyPrescription" targetRef="T_DispenseMedication" />
    <bpmn:sequenceFlow id="SF_P1" sourceRef="SE_PrescriptionReceived" targetRef="T_VerifyPrescription" />
    <bpmn:task id="T_UpdatePharmacyRecord" name="Update Dispensing Record&#10;in System">
      <bpmn:incoming>SF_P3</bpmn:incoming>
      <bpmn:outgoing>SF_PEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EE_Pharmacy" name="Medication Dispensed">
      <bpmn:incoming>SF_PEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SE_PrescriptionReceived" name="Prescription Received via Secure API">
      <bpmn:outgoing>SF_P1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T_DispenseMedication" name="Dispense Medication to Patient">
      <bpmn:incoming>SF_P2</bpmn:incoming>
      <bpmn:outgoing>SF_P3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_VerifyPrescription" name="Verify Prescription Details&#10;&#38; Drug Availability">
      <bpmn:incoming>SF_P1</bpmn:incoming>
      <bpmn:outgoing>SF_P2</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_ehealth">
      <bpmndi:BPMNShape id="Shape_Doctor" bpmnElement="Participant_Doctor" isHorizontal="true">
        <dc:Bounds x="160" y="740" width="1610" height="400" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_ReferralNeeded" bpmnElement="GW_ReferralNeeded" isMarkerVisible="true">
        <dc:Bounds x="930" y="1065" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="838" y="1090" width="84" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_IssueReferral" bpmnElement="T_IssueReferral">
        <dc:Bounds x="1050" y="1060" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EE_Doctor" bpmnElement="EE_Doctor">
        <dc:Bounds x="1632" y="992" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1619" y="1042" width="62" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_RecordDiagnosis" bpmnElement="T_RecordDiagnosis">
        <dc:Bounds x="565" y="940" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ReviewHistory" bpmnElement="T_ReviewHistory">
        <dc:Bounds x="345" y="940" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SE_DoctorConsults" bpmnElement="SE_DoctorConsults">
        <dc:Bounds x="232" y="952" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="216" y="995" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_ClinicalActions" bpmnElement="GW_ClinicalActions">
        <dc:Bounds x="790" y="945" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="722" y="1002" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_OrderLabTest" bpmnElement="T_OrderLabTest">
        <dc:Bounds x="900" y="910" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ScheduleFollowUp" bpmnElement="T_ScheduleFollowUp">
        <dc:Bounds x="1420" y="980" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_ReviewLabResults" bpmnElement="T_ReviewLabResults">
        <dc:Bounds x="1360" y="800" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_MergeActions" bpmnElement="GW_MergeActions">
        <dc:Bounds x="1315" y="985" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1255" y="1036" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_CreatePrescription" bpmnElement="T_CreatePrescription">
        <dc:Bounds x="950" y="820" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_D1" bpmnElement="SF_D1">
        <di:waypoint x="268" y="970" />
        <di:waypoint x="345" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_D2" bpmnElement="SF_D2">
        <di:waypoint x="505" y="970" />
        <di:waypoint x="565" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_D3" bpmnElement="SF_D3">
        <di:waypoint x="725" y="970" />
        <di:waypoint x="790" y="970" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_ToPrescription" bpmnElement="SF_ToPrescription">
        <di:waypoint x="815" y="945" />
        <di:waypoint x="815" y="850" />
        <di:waypoint x="950" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_ToLabOrder" bpmnElement="SF_ToLabOrder">
        <di:waypoint x="840" y="970" />
        <di:waypoint x="870" y="970" />
        <di:waypoint x="870" y="940" />
        <di:waypoint x="900" y="940" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_ToReferralCheck" bpmnElement="SF_ToReferralCheck">
        <di:waypoint x="815" y="995" />
        <di:waypoint x="815" y="1090" />
